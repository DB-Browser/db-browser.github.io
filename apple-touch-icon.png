<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 64 64" role="img" aria-label="DB Browser SQLCipher apple touch icon">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0b63a5"/>
      <stop offset="100%" stop-color="#0b5791"/>
    </linearGradient>
  </defs>
  <!-- Full-bleed background (no transparency) -->
  <rect x="0" y="0" width="64" height="64" rx="12" fill="url(#bg)"/>

  <!-- DB cylinder -->
  <g transform="translate(6,10)">
    <ellipse cx="18" cy="12" rx="12" ry="5" fill="#ffffff"/>
    <rect x="6" y="12" width="24" height="16" fill="#ffffff"/>
    <ellipse cx="18" cy="28" rx="12" ry="5" fill="#ffffff"/>
    <ellipse cx="18" cy="12" rx="12" ry="5" fill="none" stroke="#e6eef6" stroke-width="1"/>
  </g>

  <!-- Lock -->
  <g transform="translate(34,30)" fill="none" stroke="#0b2545" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="0" y="8" width="18" height="12" rx="3" fill="#ffffff"/>
    <path d="M4 8V5a7 7 0 0 1 14 0v3"/>
  </g>
</svg>